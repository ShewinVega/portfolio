---
import { cn } from "@utils/index";
interface Props {
    href?: string;
    className?: string;
}

const { href, className } = Astro.props;

const pillClass = cn(
    "rounded-full border border-white/10 bg-white/5 flex justify-center gap-x-2 py-2 px-2 hover:cursor-pointer hover:bg-white/10 hover:scale-110 transition",
    className,
);
---

{
    href && href?.length > 0 ? (
        <a
            {...Astro.props}
            class={pillClass}
            target="_blank"
            rel="noopener noreferrer"
        >
            <slot />
        </a>
    ) : (
        <div class={pillClass}>
            <slot />
        </div>
    )
}
