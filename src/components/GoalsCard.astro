---
import { Icon } from "astro-icon/components";

interface Props {
    title: string;
    logo: string;
    description: string;
    colorBand: string;
}

const { title, logo, description, colorBand } = Astro.props;
---

<div
    class:list={[
        `border-l-4 border-r-2 border-y-2 border-y-white/10 border-r-white/10 rounded-xl 
        py-10 px-6 shadow-lg transition-transform hover:scale-110`,
        colorBand,
    ]}
>
    <div class="flex items-center gap-8 mb-4">
        <Icon name={logo} size={48} />
        <h3 class="text-2xl font-semibold text-white">{title}</h3>
    </div>
    <p class="text-grey-subtitle leading-relaxed" set:html={description} />
</div>
