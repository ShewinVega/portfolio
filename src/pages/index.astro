---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import { MainLayout, SectionLayout } from "@layouts/index";
import Pill from "@src/components/Pill.astro";
import { KCarousel } from "@src/components/shared/carousel/carousel";
import GoalsCard from "@src/components/GoalsCard.astro";

import userImage from "@assets/shewin.jpeg";
import LinkedinIcon from "@icons/Linkedin.astro";
import MailIcon from "@icons/Mail.astro";

import { profile } from "@mocks/index";
import {
    projectExperienceList,
    personalProjectsList,
} from "@src/constants/projects.constants";
import { ProjectCard } from "@src/components/pages/Projects/ProjectCard";
---

<MainLayout
    title="Portfolio de Edwin Narváez - Desarrollador y programador Backend y Web con 3 años de experiencia"
>
    <!-- Hero -->
    <SectionLayout
        sectionName="hero"
        classInner="flex flex-col gap-4 py-14 mx-auto w-full"
    >
        <a
            href="https://www.linkedin.com/in/edwin-vega-9b9a07266?lipi=urn%3Ali%3Apage%3Ad_flagship3_profile_view_base_contact_details%3B3y4hOpPtQ6ivae%2F7eO2vrw%3D%3D"
            target="_blank"
            class="w-[100px] h-[100px]"
        >
            <Image
                src={userImage}
                alt="Profile Image"
                loading="lazy"
                quality="max"
                class="h-[100px] w-full rounded-full"
            />
        </a>
        <div class="flex flex-col gap-8 mt-2">
            <div>
                <span class="text-white text-h1 font-bold leading-10"
                    >Edwin Narváez</span
                >
                <div class="w-[50px] h-[8px] bg-primary-100 rounded"></div>
            </div>
            <p
                class="text-white text-h4 leading-6 opacity-80 text-pretty"
                set:html={profile.presentation_es}
            />
        </div>
        <nav class="flex gap-x-4 mt-3">
            <Pill
                href="https://www.linkedin.com/in/edwin-vega-9b9a07266?lipi=urn%3Ali%3Apage%3Ad_flagship3_profile_view_base_contact_details%3B3y4hOpPtQ6ivae%2F7eO2vrw%3D%3D"
            >
                <LinkedinIcon class="size-5" />
                <span class="text-white o text-h5 opacity-80 hidden lg:block">
                    Linkedin</span
                >
            </Pill>
            <Pill href="https://github.com/ShewinVega?tab=repositories">
                <Icon name="github" size={20} />
                <span class="text-white text-h5 opacity-80 hidden lg:block"
                    >Github</span
                >
            </Pill>
            <Pill href="mailto:edwinvega201196@gmail.com">
                <MailIcon class="size-5" />
                <span class="text-white text-h5 opacity-80 hidden lg:block"
                    >edwinvega201196@gmail.com</span
                >
            </Pill>
            <Pill href="/downloads/Curriculum.pdf">
                <Icon name="download-solid" size={20} class="text-white" />
                <span class="text-white text-h5 opacity-80 hidden lg:block"
                    >Descargar currículum</span
                >
            </Pill>
        </nav>
    </SectionLayout>

    <!-- Stack Technologico -->
    <SectionLayout sectionName="technical-stack">
        <span
            class="text-white text-h2 font-semibold mb-6 flex gap-x-1 items-center"
        >
            Stack Tecnológico
        </span>
        <div class="flex gap-x-10 gap-y-4 flex-wrap">
            {
                profile.stack_technological.map((item) => (
                    <div class="flex flex-col gap-y-2 items-center mb-2 lg:transition-transform lg:hover:scale-110">
                        <span class="text-white text-h5">{item.title}</span>
                        <div class="border-2 border-white/10 w-10 h-10 flex justify-center items-center">
                            <Icon name={item.icon} size={40} />
                        </div>
                    </div>
                ))
            }
        </div>
    </SectionLayout>

    <!-- Habilidades Profesionales -->
    <SectionLayout sectionName="professional-skills" class="pt-10">
        <div>
            <span
                class="text-white text-h2 font-semibold mb-4 flex gap-x-1 items-center"
            >
                Habilidades Profesionales
            </span>
            <div class="flex gap-2 flex-wrap">
                {
                    profile.skill.map((item) => (
                        <Pill>
                            <span class="text-white text-h5 opacity-80">
                                {item}
                            </span>
                        </Pill>
                    ))
                }
            </div>
        </div>
    </SectionLayout>

    <!-- Projects -->
    <SectionLayout
        sectionName="projects"
        classInner="flex flex-col gap-4 py-16 mx-auto w-full"
    >
        <span
            class="text-white text-h2 font-semibold mb-6 flex gap-x-1 items-center"
        >
            Proyectos
        </span>
        <KCarousel
            client:only="react"
            loop
            autoplay
            slides={{
                perView: 1,
                spacing: 10,
            }}
            breakpoints={{
                lg: {
                    slides: {
                        perView: 3,
                        spacing: 10,
                    },
                },
            }}
        >
            {
                projectExperienceList.map((item) => (
                    <div class="keen-slider__slide">
                        <ProjectCard
                            profileImage={item.profileImage}
                            name={item.name}
                            description={item.description}
                            webPage={item.webPage}
                            repository={item.repository}
                            technologies={item.technologies}
                        />
                    </div>
                ))
            }
        </KCarousel>
    </SectionLayout>

    <!-- Projects -->
    <SectionLayout
        sectionName="projects"
        classInner="flex flex-col gap-4 py-16 mx-auto w-full"
    >
        <span
            class="text-white text-h2 font-semibold mb-6 flex gap-x-1 items-center"
        >
            Proyectos personales
        </span>
        <KCarousel
            client:only="react"
            loop
            autoplay
            slides={{
                perView: 1,
                spacing: 10,
            }}
            breakpoints={{
                lg: {
                    slides: {
                        perView: 3,
                        spacing: 10,
                    },
                },
            }}
        >
            {
                personalProjectsList.map((item) => (
                    <div class="keen-slider__slide">
                        <ProjectCard
                            profileImage={item.profileImage}
                            name={item.name}
                            description={item.description}
                            webPage={item.webPage}
                            repository={item.repository}
                            technologies={item.technologies}
                        />
                    </div>
                ))
            }
        </KCarousel>
    </SectionLayout>

    <SectionLayout
        sectionName="goals"
        classInner="flex flex-col gap-4 py-16 mx-auto w-full"
    >
        <span
            class="text-white text-h2 font-semibold mb-6 flex gap-x-1 items-center"
        >
            Metas tecnológicas a futuro
        </span>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
            {
                profile.goals.map((item) => (
                    <GoalsCard
                        title={item.title}
                        logo={item.logo}
                        description={item.description}
                        colorBand={item.colorBand}
                    />
                ))
            }
        </div>
    </SectionLayout>
</MainLayout>
